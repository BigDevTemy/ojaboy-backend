generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  fullName            String               @map("full_name")
  passwordHash        String?
  authProviders       String[]             @default([])
  role                String               @default("user")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  permissions         UserPermission[]
  passwordSetupTokens PasswordSetupToken[]
  authProviderLinks   UserAuthProvider[]
  payments            Payment[]
  orders              Order[]

  @@map("users")
}

model UserAuthProvider {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("user_auth_providers")
}

model PasswordSetupToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_setup_tokens")
}

model OrderOtpChallenge {
  id                 String    @id @default(uuid())
  email              String
  fullName           String?   @map("full_name")
  codeHash           String    @map("code_hash")
  expiresAt          DateTime  @map("expires_at")
  attempts           Int       @default(0)
  verifiedAt         DateTime? @map("verified_at")
  orderTokenHash     String?   @unique @map("order_token_hash")
  orderTokenExpiresAt DateTime? @map("order_token_expires_at")
  consumedAt         DateTime? @map("consumed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("order_otp_challenges")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserPermission[]

  @@map("permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

enum MarketStatus {
  active
  inactive
}

model Market {
  id            String       @id @default(uuid())
  marketname    String
  marketaddress String?
  status        MarketStatus @default(active)
  marketPrices  MarketPrice[]
  buyPrices     BuyPrice[]
  deliveryCosts MarketDeliveryCost[]
  routesFrom    MarketRouteCost[] @relation("MarketRouteFrom")
  routesTo      MarketRouteCost[] @relation("MarketRouteTo")

  @@map("markets")
}

model DeliveryZone {
  id            String               @id @default(uuid())
  name          String               @unique
  description   String?
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deliveryCosts MarketDeliveryCost[]

  @@map("delivery_zones")
}

model MarketDeliveryCost {
  id               String       @id @default(uuid())
  marketId         String       @map("market_id")
  deliveryZoneId   String       @map("delivery_zone_id")
  cost             Decimal      @db.Decimal(12, 2)
  currency         String       @default("NGN")
  estimatedMinutes Int?         @map("estimated_minutes")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deliveryZone     DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  market           Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, deliveryZoneId])
  @@index([marketId])
  @@index([deliveryZoneId])
  @@index([isActive])
  @@map("market_delivery_costs")
}

model MarketRouteCost {
  id               String   @id @default(uuid())
  fromMarketId     String   @map("from_market_id")
  toMarketId       String   @map("to_market_id")
  cost             Decimal  @db.Decimal(12, 2)
  currency         String   @default("NGN")
  estimatedMinutes Int?     @map("estimated_minutes")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  fromMarket       Market   @relation("MarketRouteFrom", fields: [fromMarketId], references: [id], onDelete: Cascade)
  toMarket         Market   @relation("MarketRouteTo", fields: [toMarketId], references: [id], onDelete: Cascade)

  @@unique([fromMarketId, toMarketId])
  @@index([fromMarketId])
  @@index([toMarketId])
  @@index([isActive])
  @@map("market_route_costs")
}

enum ProductStatus {
  active
  inactive
  out_of_stock
}

enum ProductCategory {
  Fruits
  Grains
  Vegetables
  Meat
  Seafood
  Dairy
  Bakery
  Beverages
  Snacks
  Spices
  Oils
  Legumes
  Tubers
  FrozenFoods
  Household
  PersonalCare
  Other
}

enum PriceUnit {
  kg
  bag
  basket
  paint_bucket
  crate
  litre
  bottle
  bunch
  piece
  derica
}

enum PriceQualityGrade {
  low
  standard
  premium
}

enum PriceSource {
  manual
  agent
  scraper
  partner
  admin
}

enum BuyPriceStrategy {
  cheapest
  average
  median
  preferred_market
  single_market
  quality_first
  fastest_fulfillment
  hybrid_landed_cost
  manual_override
}

model Product {
  id           String         @id @default(uuid())
  name         String
  description  String?
  sku          String         @unique
  category     ProductCategory?
  imageUrl     String?        @map("image_url")
  status       ProductStatus  @default(active)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  marketPrices MarketPrice[]
  buyPrices    BuyPrice[]
  orderItems   OrderItem[]

  @@index([category])
  @@map("products")
}

model MarketPrice {
  id           String            @id @default(uuid())
  productId    String            @map("product_id")
  marketId     String            @map("market_id")
  amount       Decimal           @db.Decimal(12, 2)
  currency     String            @default("NGN")
  unit         PriceUnit
  quantity     Decimal           @default(1) @db.Decimal(12, 2)
  qualityGrade PriceQualityGrade @default(standard) @map("quality_grade")
  source       PriceSource       @default(manual)
  observedAt   DateTime          @map("observed_at")
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  market       Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyPrices    BuyPrice[]

  @@unique([productId, marketId, unit, observedAt])
  @@index([productId])
  @@index([marketId])
  @@index([observedAt])
  @@map("market_prices")
}

model BuyPrice {
  id                String       @id @default(uuid())
  productId         String       @map("product_id")
  marketId          String?      @map("market_id")
  marketPriceId     String?      @map("market_price_id")
  baseMarketPrice   Decimal      @db.Decimal(12, 2) @map("base_market_price")
  marginAmount      Decimal      @default(0) @db.Decimal(12, 2) @map("margin_amount")
  logisticsBuffer   Decimal      @default(0) @db.Decimal(12, 2) @map("logistics_buffer")
  riskBuffer        Decimal      @default(0) @db.Decimal(12, 2) @map("risk_buffer")
  finalPrice        Decimal      @db.Decimal(12, 2) @map("final_price")
  currency          String       @default("NGN")
  unit              PriceUnit
  strategyUsed      BuyPriceStrategy @default(cheapest) @map("strategy_used")
  isActive          Boolean      @default(true) @map("is_active")
  validFrom         DateTime     @default(now()) @map("valid_from")
  validUntil        DateTime?    @map("valid_until")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  market            Market?      @relation(fields: [marketId], references: [id], onDelete: SetNull)
  marketPrice       MarketPrice? @relation(fields: [marketPriceId], references: [id], onDelete: SetNull)
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]

  @@index([productId])
  @@index([marketId])
  @@index([marketPriceId])
  @@index([isActive])
  @@index([strategyUsed])
  @@map("buy_prices")
}

enum OrderStatus {
  pending
  confirmed
  processing
  out_for_delivery
  delivered
  cancelled
}

model Order {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  status    OrderStatus @default(pending)
  subtotal  Decimal     @default(0) @db.Decimal(12, 2)
  serviceFee Decimal    @default(0) @db.Decimal(12, 2) @map("service_fee")
  deliveryFee Decimal   @default(0) @db.Decimal(12, 2) @map("delivery_fee")
  total     Decimal     @default(0) @db.Decimal(12, 2)
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  payments  Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String    @map("order_id")
  productId  String    @map("product_id")
  buyPriceId String?   @map("buy_price_id")
  quantity   Decimal   @db.Decimal(12, 2)
  unit       PriceUnit
  unitPrice  Decimal   @db.Decimal(12, 2) @map("unit_price")
  totalPrice Decimal   @db.Decimal(12, 2) @map("total_price")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  buyPrice   BuyPrice? @relation(fields: [buyPriceId], references: [id], onDelete: SetNull)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([buyPriceId])
  @@map("order_items")
}

enum PaymentProvider {
  paystack
  flutterwave
  stripe
  bank_transfer
  cash
}

enum PaymentStatus {
  pending
  successful
  failed
  cancelled
  refunded
}

model Payment {
  id                String          @id @default(uuid())
  userId            String          @map("user_id")
  orderId           String?         @map("order_id")
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("NGN")
  provider          PaymentProvider
  providerReference String?         @unique @map("provider_reference")
  status            PaymentStatus   @default(pending)
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}
